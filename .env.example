# python3 scripts/run.py creates a private .env with generated secrets.
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8000
AEGIS_DB=data/aegis.db
AEGIS_API_TOKEN=
# Keep this key with your backup. Do not change it for an existing database.
AEGIS_AUDIT_KEY=
# Optional array of {"name":"analyst","role":"analyst","token":"<random token>"}.
# Supported roles: viewer, ingest, analyst, approver, admin.
AEGIS_IDENTITIES=[]
AEGIS_TWO_PERSON=false
AEGIS_RATE_LIMIT=240
